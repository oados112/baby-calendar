# העתיקו לקובץ .env.local ומלאו. הקובץ .env.local לעולם לא נכנס ל-git.

# --- Supabase (מתוך Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# כתובת האתר, לבניית קישורי התחברות והזמנה
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- התראות Web Push ---
# נוצרים פעם אחת: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
