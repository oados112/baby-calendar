# העתיקו לקובץ .env.local ומלאו. הקובץ .env.local לעולם לא נכנס ל-git.

# --- Supabase (מתוך Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# מפתח שרת. נדרש לכניסה בקוד אישי. לעולם לא בקוד הלקוח, לעולם לא ב-git.
SUPABASE_SERVICE_ROLE_KEY=

# כתובת האתר. בדפדפן נלקחת אוטומטית; זה רק גיבוי לצד השרת.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- התראות Web Push ---
# נוצרים פעם אחת: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
